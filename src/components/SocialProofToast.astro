---
// Social proof "recent order" toast. Rendered on every page via the base layout.
// Behaviour (vanilla JS below): slides in bottom-left every 18-25s, shows 6s.
---

<div
  id="proof-toast"
  class="pointer-events-none fixed bottom-4 left-3 right-3 z-40 translate-x-[-120%] opacity-0 transition-all duration-500 ease-out sm:left-5 sm:right-auto sm:w-[340px] sm:bottom-5"
  role="status"
  aria-live="polite"
>
  <div
    id="proof-card"
    class="pointer-events-auto relative flex items-center gap-3 rounded-2xl bg-cream-50/95 p-3.5 pr-10 shadow-[0_18px_45px_-12px_rgba(43,20,17,0.4)] ring-1 ring-gold-400/50 backdrop-blur"
  >
    <span id="proof-icon" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl shadow-inner"></span>
    <div class="min-w-0 flex-1">
      <p id="proof-text" class="text-[13px] font-medium leading-snug text-stone-800"></p>
      <p class="mt-1 flex items-center gap-1.5 text-[11px] text-stone-500">
        <span id="proof-time"></span>
        <span class="text-stone-300">•</span>
        <span class="inline-flex items-center gap-1 font-semibold text-green-700">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          Verified order
        </span>
      </p>
    </div>
    <button
      id="proof-close"
      aria-label="Dismiss"
      class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-700"
    >
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
</div>

<script>
  import { SOCIAL_PROOF_ENTRIES } from '../data/socialProof';

  const ICONS: Record<string, { bg: string; svg: string }> = {
    'logo-mount': {
      bg: 'linear-gradient(135deg,#232a3a,#10141f)',
      svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#d1a04e" stroke-width="1.8"><rect x="4" y="6" width="16" height="12" rx="2"/><circle cx="12" cy="12" r="3"/></svg>',
    },
    cutout: {
      bg: 'linear-gradient(135deg,#6d1f2e,#3f1620)',
      svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#f4d998" stroke-width="1.8"><rect x="5" y="4" width="14" height="16" rx="2"/><circle cx="12" cy="10" r="2.5"/><path d="M7 17l3.5-3.5 2.5 2.5 3-3.5"/></svg>',
    },
    led: {
      bg: 'linear-gradient(135deg,#131c2e,#070b16)',
      svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffd98a" stroke-width="1.8" stroke-linecap="round"><path d="M9 21h6M12 3a6 6 0 0 1 3.5 10.9c-.8.6-1.5 1.3-1.5 2.6h-4c0-1.3-.7-2-1.5-2.6A6 6 0 0 1 12 3z"/></svg>',
    },
    magnet: {
      bg: 'linear-gradient(135deg,#8a3b22,#4a1f10)',
      svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#f5edd6" stroke-width="1.8" stroke-linecap="round"><path d="M6 4v7a6 6 0 0 0 12 0V4"/><path d="M6 4h4v5H6zM14 4h4v5h-4z" fill="#f5edd6" stroke="none" opacity="0.85"/></svg>',
    },
    divine: {
      bg: 'linear-gradient(135deg,#4a1a12,#1c0a08)',
      svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffca66" stroke-width="1.8" stroke-linecap="round"><path d="M12 3c-4 5-6 8-6 12a6 6 0 0 0 12 0c0-4-2-7-6-12z"/><path d="M12 21v-8"/></svg>',
    },
    returngift: {
      bg: 'linear-gradient(135deg,#5c1f33,#33101b)',
      svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ead9ab" stroke-width="1.8" stroke-linecap="round"><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M4 6h16v3H4zM12 6v14"/></svg>',
    },
    corporate: {
      bg: 'linear-gradient(135deg,#1e2a44,#0e1526)',
      svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#8ab4dc" stroke-width="1.8"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>',
    },
  };

  const toast = document.getElementById('proof-toast') as HTMLElement | null;
  const card = document.getElementById('proof-card') as HTMLElement | null;
  const iconEl = document.getElementById('proof-icon') as HTMLElement | null;
  const textEl = document.getElementById('proof-text') as HTMLElement | null;
  const timeEl = document.getElementById('proof-time') as HTMLElement | null;
  const closeBtn = document.getElementById('proof-close') as HTMLElement | null;

  if (toast && card && iconEl && textEl && timeEl && closeBtn) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lastIdx = -1;
    let hideTimer: number | undefined;
    let showTimer: number | undefined;

    function pick(): number {
      let i: number;
      do {
        i = Math.floor(Math.random() * SOCIAL_PROOF_ENTRIES.length);
      } while (i === lastIdx && SOCIAL_PROOF_ENTRIES.length > 1);
      lastIdx = i;
      return i;
    }

    function show() {
      const e = SOCIAL_PROOF_ENTRIES[pick()];
      const icon = ICONS[e.line] ?? ICONS['cutout'];
      iconEl!.style.background = icon.bg;
      iconEl!.innerHTML = icon.svg;
      textEl!.innerHTML = `<strong class="font-semibold text-maroon-950">${e.name}</strong> from ${e.city} ordered a <strong class="font-semibold text-maroon-950">${e.product}</strong>`;
      timeEl!.textContent = e.time;
      toast!.classList.remove('translate-x-[-120%]', 'opacity-0');
      hideTimer = window.setTimeout(hide, 6000);
    }

    function hide() {
      window.clearTimeout(hideTimer);
      toast!.classList.add('translate-x-[-120%]', 'opacity-0');
      schedule();
    }

    function schedule() {
      window.clearTimeout(showTimer);
      showTimer = window.setTimeout(show, 18000 + Math.random() * 7000);
    }

    card.addEventListener('mouseenter', () => window.clearTimeout(hideTimer));
    card.addEventListener('mouseleave', () => {
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(hide, 2500);
    });
    closeBtn.addEventListener('click', hide);

    if (!reduceMotion && SOCIAL_PROOF_ENTRIES.length > 0) {
      showTimer = window.setTimeout(show, 6000);
    }
  }
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    #proof-toast { transition: none; }
  }
</style>
