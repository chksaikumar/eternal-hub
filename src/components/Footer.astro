---
import { PHONE_DISPLAY, WHATSAPP, INSTAGRAM } from '../data/site';
---

<footer class="bg-maroon-950 text-cream-100">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-gold-400 to-gold-600 font-display text-xl font-bold text-maroon-950">E</span>
          <span class="font-display text-2xl font-bold">Eternal <span class="text-gold-400">Hub</span></span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream-200/80">
          Manufacturer of premium customized gifts. Acrylic, wooden, LED, metal and UV printed gifts, crafted in our own unit and delivered across India.
        </p>
        <a href={INSTAGRAM} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 rounded-full border border-gold-500/40 px-5 py-2.5 text-sm font-semibold text-gold-300 transition-all hover:bg-gold-500/10">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.9.1s-3.6 0-4.9-.1c-3.3-.1-4.8-1.7-4.9-4.9-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8C2.4 4 4 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-9.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z"/></svg>
          10k+ community on Instagram
        </a>
      </div>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-gold-400">Explore</h4>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/" class="text-cream-200/80 hover:text-gold-300">Home</a></li>
          <li><a href="/products" class="text-cream-200/80 hover:text-gold-300">Products</a></li>
          <li><a href="/business" class="text-cream-200/80 hover:text-gold-300">Business Branding</a></li>
          <li><a href="/about" class="text-cream-200/80 hover:text-gold-300">About Us</a></li>
          <li><a href="/contact" class="text-cream-200/80 hover:text-gold-300">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-widest text-gold-400">Order</h4>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href={`tel:${PHONE_DISPLAY.replace(/\s/g, '')}`} class="text-cream-200/80 hover:text-gold-300">{PHONE_DISPLAY}</a></li>
          <li><a href={WHATSAPP} target="_blank" rel="noopener" class="text-cream-200/80 hover:text-gold-300">WhatsApp Us</a></li>
          <li><a href={INSTAGRAM} target="_blank" rel="noopener" class="text-cream-200/80 hover:text-gold-300">Instagram DM</a></li>
        </ul>
        <p class="mt-4 text-xs text-cream-200/60">Open all days, 10 AM to 8 PM IST</p>
      </div>
    </div>
    <div class="mt-12 border-t border-white/10 pt-6 text-center text-xs text-cream-200/60">
      <p>Copyright 2026 Eternal Hub. Premium customized gifts, manufactured in India.</p>
    </div>
  </div>
</footer>
