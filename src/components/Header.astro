---
const links = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/#videos', label: 'Videos' },
  { href: '/business', label: 'Business Branding' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-forest-950/95 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5">
      <span class="relative inline-flex h-10 w-10 shrink-0">
        <span class="logo-halo absolute -inset-1.5 rounded-full" aria-hidden="true"></span>
        <img
          src="/logo.jpg"
          alt="Eternal Hub logo"
          width="40"
          height="40"
          class="relative h-10 w-10 rounded-full object-cover ring-1 ring-gold-300/60"
          style="filter: drop-shadow(0 0 10px rgba(209,160,78,0.45));"
        />
      </span>
      <span class="font-display text-xl font-bold tracking-tight text-cream-50">
        Eternal <span class="text-gold-400">Hub</span>
      </span>
    </a>
    <nav class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class={`rounded-full px-4 py-2 text-sm font-medium transition-all ${current === l.href ? 'bg-white/10 text-gold-300' : 'text-cream-200/75 hover:bg-white/5 hover:text-cream-50'}`}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a
        href="https://wa.me/918522810360?text=Hi%20Eternal%20Hub!%20I%20want%20to%20order%20a%20customised%20gift."
        target="_blank"
        rel="noopener"
        class="hidden rounded-full bg-[#1faa53] px-5 py-2.5 text-sm font-semibold text-white shadow-md transition-all hover:-translate-y-0.5 hover:bg-[#178f45] sm:inline-flex"
      >
        Order on WhatsApp
      </a>
      <button id="menu-btn" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-cream-100 md:hidden" aria-label="Open menu">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-white/10 bg-forest-950 px-4 py-3 md:hidden">
    <div class="flex flex-col gap-1">
      {links.map((l) => (
        <a
          href={l.href}
          class={`rounded-xl px-4 py-2.5 text-sm font-medium ${current === l.href ? 'bg-white/10 text-gold-300' : 'text-cream-200/80 hover:bg-white/5'}`}
        >
          {l.label}
        </a>
      ))}
      <a
        href="https://wa.me/918522810360?text=Hi%20Eternal%20Hub!%20I%20want%20to%20order%20a%20customised%20gift."
        target="_blank"
        rel="noopener"
        class="mt-2 rounded-xl bg-[#1faa53] px-4 py-3 text-center text-sm font-semibold text-white"
      >
        Order on WhatsApp
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => nav?.classList.toggle('hidden'));
</script>
