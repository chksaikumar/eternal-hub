---
import ProductArt from './ProductArt.astro';
import { waLink, LINES, type Product } from '../data/site';

export interface Props {
  product: Product;
}
const { product } = Astro.props;
const lineName = LINES.find((l) => l.id === product.line)?.name ?? '';
---

<div class="card group flex flex-col overflow-hidden !p-0">
  <ProductArt art={product.art} class="aspect-[10/7] w-full rounded-b-none transition-transform duration-500 group-hover:scale-[1.03]" />
  <div class="flex flex-1 flex-col p-6">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold-600">{lineName}</p>
    <h3 class="mt-2 font-display text-xl font-bold text-maroon-950">{product.name}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{product.detail}</p>
    <p class="mt-4 text-xs font-semibold text-maroon-700">{product.priceNote}</p>
    <a
      href={waLink(`Hi Eternal Hub! I am interested in the ${product.name}. Please share price and details.`)}
      target="_blank"
      rel="noopener"
      class="mt-4 inline-flex items-center justify-center gap-2 rounded-full bg-[#1faa53] px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-[#178f45]"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.2-.7.3-.9.9-1.1 2.2-.2 3.9a11.6 11.6 0 0 0 4.5 4.2c1.7.8 2.4.9 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3z"/></svg>
      Order on WhatsApp
    </a>
  </div>
</div>
