---
import Base from '../layouts/Base.astro';
import ProductArt from '../components/ProductArt.astro';
import { WHATSAPP } from '../data/site';

const offerings = [
  {
    t: 'Acrylic logo mounts',
    d: 'Raised 3D logos and letters for reception walls, cabins and shop fronts. Standoff mounted for a floating premium look.',
    art: 'logo-mount',
    photo: '/products/logo-mounts.jpg',
  },
  {
    t: 'Office name boards',
    d: 'Backlit and non lit name boards for offices, clinics and showrooms. Crisp lettering, clean installation guidance.',
    art: 'led',
    photo: null,
  },
  {
    t: 'Corporate gift sets',
    d: 'Branded desk name plates, metal card holders, engraved mementos and festive hampers for teams, clients and partners.',
    art: 'corporate',
    photo: null,
  },
  {
    t: 'Event trophies and mementos',
    d: 'Custom trophies, shields and mementos for annual days, sports meets and award nights, with your logo and text.',
    art: 'corporate',
    photo: null,
  },
];
---

<Base
  title="Business Branding and Corporate Gifts | Eternal Hub"
  description="Premium acrylic logo mounts, office branding and bulk corporate gifts, manufactured factory direct. Bulk pricing for businesses across India."
  path="/business"
>
  <section class="relative overflow-hidden bg-forest-950 py-14 sm:py-20">
    <div class="absolute inset-0 opacity-40" style="background: radial-gradient(ellipse 50% 50% at 80% 20%, #c78d3c44, transparent);"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <p class="section-eyebrow !text-gold-400"><span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>For businesses</p>
      <h1 class="max-w-3xl font-display text-3xl font-bold leading-tight text-cream-50 sm:text-5xl">
        Branding that makes your business look <span class="bg-gradient-to-r from-gold-300 to-gold-500 bg-clip-text text-transparent">established</span>
      </h1>
      <p class="mt-5 max-w-2xl text-cream-200/85 sm:text-lg">
        Premium acrylic logo mounts, office signage and corporate gifts, manufactured in our own factory. Factory direct pricing for single offices, retail chains and bulk gifting programs.
      </p>
      <a href="#bulk-form" class="btn-gold mt-8">Request bulk pricing</a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="grid gap-6 sm:grid-cols-2">
      {offerings.map((o) => (
        <div class="card !p-0 overflow-hidden">
          {o.photo ? (
            <img src={o.photo} alt={o.t} loading="lazy" class="aspect-[16/7] w-full object-cover" />
          ) : (
            <ProductArt art={o.art} class="aspect-[16/7] w-full rounded-b-none" />
          )}
          <div class="p-6">
            <h2 class="font-display text-xl font-bold text-forest-950">{o.t}</h2>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{o.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-cream-100 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="text-center">
        <p class="section-eyebrow justify-center"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>Why businesses choose us</p>
        <h2 class="section-title">Built for B2B, priced for scale</h2>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Factory direct rates', 'No reseller margins. Honest bulk pricing that respects your budget.'],
          ['Consistent branding', 'Same colours, same finish across 10 pieces or 10,000.'],
          ['Deadline driven', 'We plan production around your event or launch date.'],
          ['Pan India delivery', 'Carefully packed and shipped to single or multiple addresses.'],
        ].map(([t, d]) => (
          <div class="card">
            <h3 class="font-display text-lg font-bold text-forest-950">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="bulk-form" class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="text-center">
      <p class="section-eyebrow justify-center"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>Bulk enquiry</p>
      <h2 class="section-title">Tell us what you need</h2>
      <p class="mt-4 text-stone-600">Fill this in and it opens WhatsApp with your enquiry pre typed. Just press send.</p>
    </div>
    <form id="bulk-enquiry" class="card mt-10 !p-6 sm:!p-8">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="b-name">Your name</label>
          <input id="b-name" required class="input-field" placeholder="Rahul Sharma" />
        </div>
        <div>
          <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="b-company">Company</label>
          <input id="b-company" required class="input-field" placeholder="Sharma Retail Pvt Ltd" />
        </div>
        <div>
          <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="b-qty">Approximate quantity</label>
          <input id="b-qty" required class="input-field" placeholder="e.g. 100 pieces" />
        </div>
        <div>
          <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="b-city">City</label>
          <input id="b-city" required class="input-field" placeholder="Hyderabad" />
        </div>
      </div>
      <div class="mt-4">
        <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="b-need">What do you need?</label>
        <textarea id="b-need" required rows="4" class="input-field" placeholder="e.g. Acrylic logo mounts for 3 store fronts, roughly 2 ft x 1 ft each. Need delivery before month end."></textarea>
      </div>
      <button type="submit" class="btn-whatsapp mt-6 w-full">
        Send enquiry on WhatsApp
      </button>
      <p class="mt-3 text-center text-xs text-stone-500">Opens WhatsApp with your message ready. No spam, no cold calls.</p>
    </form>
  </section>
</Base>

<script>
  const form = document.getElementById('bulk-enquiry') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value.trim();
    const msg = `Hi Eternal Hub! Bulk enquiry:\nName: ${v('b-name')}\nCompany: ${v('b-company')}\nQuantity: ${v('b-qty')}\nCity: ${v('b-city')}\nRequirement: ${v('b-need')}`;
    window.open(`https://wa.me/918522810360?text=${encodeURIComponent(msg)}`, '_blank');
  });
</script>
