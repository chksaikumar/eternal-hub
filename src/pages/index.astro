---
import Base from '../layouts/Base.astro';
import ProductArt from '../components/ProductArt.astro';
import ProductCard from '../components/ProductCard.astro';
import { LINES, PRODUCTS, FAQS, TESTIMONIALS, waLink, PHONE_DISPLAY } from '../data/site';

const featured = PRODUCTS.filter((p) => p.featured);
const REELS = [
  { code: 'DeG1Ba3zPKm', caption: 'Customer review: unboxing her custom frame' },
  { code: 'Dd_m23IMyvV', caption: 'Customer review: LED frame reveal' },
  { code: 'Dd6mBfZMZBZ', caption: 'How our cutout frames are made' },
  { code: 'Dd328ouMWc-', caption: 'LED frames that glow' },
  { code: 'Dcv67iuMxa_', caption: 'Divine collection: Venkateshwara art' },
  { code: 'DdyIBPvsoKW', caption: 'Return gifts, packed with love' },
  { code: 'DeE85akzTIX', caption: 'Custom fridge magnets' },
];
const showcase = [
  { art: 'logo-mount', photo: '/products/logo-mounts.jpg', label: 'Logo Mounts', price: 'from Rs 599', tilt: '-rotate-6', pos: 'z-10 -mr-10 mt-8' },
  { art: 'divine', photo: '/products/divine.jpg', label: 'Divine Collection', price: 'puja room art', tilt: 'rotate-3', pos: 'z-20' },
  { art: 'led', photo: null, label: 'LED Frames', price: 'glowing gifts', tilt: 'rotate-6', pos: 'z-10 -ml-10 mt-12' },
];
---

<Base
  title="Eternal Hub | Premium Customized Gifts, Manufactured in India"
  description="Eternal Hub manufactures premium customized gifts: acrylic logo mounts from Rs 599, cutout photo frames, LED frames, divine acrylic art, return gifts and corporate gifting. Factory direct, order on WhatsApp."
  path="/"
>
  <!-- ATELIER HERO -->
  <section class="relative overflow-hidden bg-forest-950">
    <div class="absolute inset-0 opacity-50" style="background: radial-gradient(ellipse 55% 45% at 15% 15%, #1a423099, transparent), radial-gradient(ellipse 45% 40% at 88% 82%, #c78d3c2e, transparent);"></div>
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(#d1a04e 1px, transparent 1px); background-size: 30px 30px;"></div>

    <div class="relative mx-auto max-w-7xl px-4 pb-16 pt-14 sm:px-6 lg:pb-24 lg:pt-20">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="text-center lg:text-left">
          <p class="section-eyebrow !text-gold-400 lg:justify-start">
            <span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>
            The gift atelier of India
          </p>
          <h1 class="font-display text-4xl font-bold leading-[1.08] text-cream-50 sm:text-5xl lg:text-[3.6rem]">
            Crafted in our factory.<br />
            <span class="bg-gradient-to-r from-gold-200 via-gold-400 to-gold-300 bg-clip-text italic text-transparent">Gifted from your heart.</span>
          </h1>
          <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-cream-200/85 sm:text-lg lg:mx-0">
            Premium acrylic logo mounts from <span class="font-semibold text-gold-300">Rs 599</span>, glowing LED frames, divine acrylic art and return gifts. Made by us, priced for you.
          </p>
          <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row lg:justify-start sm:justify-center">
            <a href={waLink('Hi Eternal Hub! I want to order a customised gift.')} target="_blank" rel="noopener" class="btn-whatsapp w-full sm:w-auto">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.2-.7.3-.9.9-1.1 2.2-.2 3.9a11.6 11.6 0 0 0 4.5 4.2c1.7.8 2.4.9 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3z"/></svg>
              Order on WhatsApp
            </a>
            <a href="/products" class="btn-outline w-full !border-gold-500/40 !bg-white/5 !text-cream-50 hover:!bg-white/10 sm:w-auto">
              Explore the collection
            </a>
          </div>
          <div class="mt-10 flex items-center justify-center gap-6 text-sm text-cream-200/75 lg:justify-start">
            <span class="flex items-center gap-2"><svg viewBox="0 0 24 24" class="h-4 w-4 text-gold-400" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg>10k+ Instagram family</span>
            <span class="flex items-center gap-2"><svg viewBox="0 0 24 24" class="h-4 w-4 text-gold-400" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Factory direct</span>
            <span class="hidden items-center gap-2 sm:flex"><svg viewBox="0 0 24 24" class="h-4 w-4 text-gold-400" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Budget friendly</span>
          </div>
        </div>

        <div class="relative mx-auto hidden w-full max-w-md sm:block lg:max-w-none">
          <div class="flex items-start justify-center">
            {showcase.map((s) => (
              <div class={`w-52 shrink-0 ${s.pos} ${s.tilt} transition-transform duration-500 hover:rotate-0 hover:scale-105 lg:w-60`}>
                <div class="overflow-hidden rounded-3xl shadow-2xl shadow-black/50 ring-1 ring-gold-500/30">
                  {s.photo ? (
                    <img src={s.photo} alt={s.label} loading="lazy" class="aspect-[4/3] w-full object-cover" />
                  ) : (
                    <ProductArt art={s.art} class="aspect-[4/3] w-full !rounded-none" />
                  )}
                </div>
                <div class="mt-3 text-center">
                  <p class="text-sm font-semibold text-cream-100">{s.label}</p>
                  <p class="text-xs text-gold-400">{s.price}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="absolute -bottom-6 left-1/2 h-10 w-3/4 -translate-x-1/2 rounded-[100%] bg-black/50 blur-2xl"></div>
        </div>
      </div>
    </div>

    <div class="relative border-t border-white/10 bg-forest-950/80 py-4 backdrop-blur">
      <div class="marquee flex gap-10 overflow-hidden whitespace-nowrap">
        {[...LINES, ...LINES].map((l) => (
          <span class="flex items-center gap-10 text-xs font-semibold uppercase tracking-[0.25em] text-gold-400/80">
            {l.name} <span class="text-gold-600">✦</span>
          </span>
        ))}
      </div>
    </div>
    <style>.marquee{animation:marq 30s linear infinite;}@keyframes marq{to{transform:translateX(-50%)}}</style>
  </section>

  <!-- THE COLLECTION -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="text-center">
      <p class="section-eyebrow justify-center"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>The collection</p>
      <h2 class="section-title">Seven crafts, straight from our machines</h2>
      <p class="mx-auto mt-4 max-w-2xl text-stone-600">Real products from our Instagram, made in our own unit. Pick your craft.</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {LINES.map((l, i) => (
        <a href="/products" class={`card group !p-0 overflow-hidden ${i === 0 ? 'sm:col-span-2 lg:col-span-1 ring-2 !ring-gold-400/60' : ''}`}>
          <div class="relative overflow-hidden">
            {l.photo ? (
              <img
                src={l.photo}
                alt={l.name}
                loading="lazy"
                class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            ) : (
              <ProductArt art={l.art} class="aspect-[16/9] w-full rounded-b-none transition-transform duration-500 group-hover:scale-[1.04]" />
            )}
            {i === 0 && (
              <span class="absolute left-4 top-4 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 px-4 py-1.5 text-[11px] font-bold uppercase tracking-widest text-forest-950 shadow-lg">Bestseller</span>
            )}
          </div>
          <div class="p-6">
            <h3 class="font-display text-xl font-bold text-forest-950">{l.name}</h3>
            <p class="mt-1 text-sm font-semibold text-gold-700">{l.tagline}</p>
            <p class="mt-3 text-sm leading-relaxed text-stone-600">{l.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  <section class="bg-gradient-to-b from-cream-100 to-cream-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>Most loved on Instagram</p>
          <h2 class="section-title">Featured pieces</h2>
        </div>
        <a href="/products" class="btn-outline !px-5 !py-2.5">View all products</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- OFFER BANNER -->
  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="card group !p-0 grid overflow-hidden md:grid-cols-2">
      <div class="overflow-hidden">
        <img
          src="/products/offer-599.jpg"
          alt="Acrylic logo mounts starting from Rs 599"
          loading="lazy"
          class="h-full min-h-[260px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
      <div class="flex flex-col justify-center p-8 sm:p-12">
        <p class="section-eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>Limited period offer</p>
        <h2 class="font-display text-3xl font-bold text-forest-950 sm:text-4xl">Premium acrylic logo mounts from just Rs 599</h2>
        <p class="mt-4 text-sm leading-relaxed text-stone-600 sm:text-base">Give your shop, office or clinic a premium identity. Laser cut 3D acrylic letters with standoff mounts, crafted in our own factory. Share your logo on WhatsApp and get a quote today.</p>
        <div class="mt-7">
          <a href={waLink('Hi Eternal Hub! I want the Rs 599 acrylic logo mount offer. Here is my logo:')} target="_blank" rel="noopener" class="btn-whatsapp">
            Claim the offer on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WATCH US CRAFT: INSTAGRAM REELS -->
  <section id="videos" class="scroll-mt-16 bg-forest-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="text-center">
        <p class="section-eyebrow justify-center !text-gold-400"><span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>Straight from Instagram</p>
        <h2 class="font-display text-3xl font-bold text-cream-50 sm:text-4xl">Watch us craft</h2>
        <p class="mx-auto mt-4 max-w-2xl text-cream-200/80">Real customer reviews and behind the scenes videos from our workshop. Swipe through.</p>
      </div>
    </div>
    <div class="mt-10 overflow-x-auto pb-4 [scrollbar-width:thin]">
      <div class="mx-auto flex w-max max-w-none snap-x snap-mandatory gap-5 px-4 sm:px-6">
        {REELS.map((r) => (
          <figure class="w-[280px] shrink-0 snap-center overflow-hidden rounded-3xl bg-white/5 ring-1 ring-white/10 sm:w-[320px]">
            <iframe
              src={`https://www.instagram.com/reel/${r.code}/embed`}
              loading="lazy"
              title={r.caption}
              class="h-[440px] w-full border-0 bg-forest-900"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture"
            ></iframe>
            <figcaption class="border-t border-white/10 p-4 text-sm font-medium text-cream-200/90">{r.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
    <div class="mt-6 text-center">
      <a href="https://www.instagram.com/eternalhub.est2026" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-gold-500/40 px-6 py-3 text-sm font-semibold text-gold-300 transition-all hover:bg-gold-500/10">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.9.1s-3.6 0-4.9-.1c-3.3-.1-4.8-1.7-4.9-4.9-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8C2.4 4 4 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-9.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z"/></svg>
        Follow @eternalhub.est2026
      </a>
    </div>
  </section>

  <!-- HOW ORDERING WORKS -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="text-center">
      <p class="section-eyebrow justify-center"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>Simple as a message</p>
      <h2 class="section-title">Ordering in 3 easy steps</h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {[
        { n: '1', t: 'Share your design on WhatsApp', d: 'Send your photo, logo or idea to us on WhatsApp. Tell us the occasion and we will suggest the perfect gift and size.' },
        { n: '2', t: 'We craft it in our factory', d: 'Our team cuts, prints and finishes your gift with care. We share a preview for your approval before final finishing.' },
        { n: '3', t: 'Doorstep delivery across India', d: 'Your gift is packed with protective layers and shipped to your address. Track it all the way to the doorstep.' },
      ].map((s) => (
        <div class="card relative overflow-hidden">
          <span class="font-display text-6xl font-bold text-forest-100">{s.n}</span>
          <h3 class="mt-2 font-display text-xl font-bold text-forest-950">{s.t}</h3>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">{s.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href={waLink('Hi Eternal Hub! I want to order a customised gift.')} target="_blank" rel="noopener" class="btn-whatsapp">
        Start your order on WhatsApp
      </a>
    </div>
  </section>

  <!-- FACTORY DIRECT BANNER -->
  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="relative overflow-hidden rounded-[2rem] bg-forest-950 px-6 py-14 sm:px-12">
      <div class="absolute inset-0 opacity-40" style="background: radial-gradient(ellipse 50% 60% at 80% 20%, #c78d3c44, transparent);"></div>
      <div class="relative grid items-center gap-8 lg:grid-cols-2">
        <div>
          <p class="section-eyebrow !text-gold-400"><span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>Why factory direct wins</p>
          <h2 class="font-display text-3xl font-bold text-cream-50 sm:text-4xl">No middlemen. Just honest craft at honest prices.</h2>
          <p class="mt-4 text-cream-200/85 leading-relaxed">Resellers add margins at every step. We design, cut, print and finish everything under our own roof, so you pay for the gift, not the chain of commissions.</p>
          <a href="/about" class="btn-gold mt-7">Our story</a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          {[
            ['Logo mounts from Rs 599', 'Our hero product. Premium 3D branding any shop can afford.'],
            ['10k+ Instagram family', 'A community that trusts us with birthdays, weddings and launches.'],
            ['Full customisation', 'Any photo, name, logo or deity. If you can dream it, we can craft it.'],
            ['Bulk ready', 'Return gifts and corporate orders in any quantity, on your timeline.'],
          ].map(([t, d]) => (
            <div class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10 backdrop-blur">
              <p class="font-display text-base font-bold text-gold-300">{t}</p>
              <p class="mt-2 text-xs leading-relaxed text-cream-200/75">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="text-center">
      <p class="section-eyebrow justify-center"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>Happy customers</p>
      <h2 class="section-title">Loved across India</h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {TESTIMONIALS.map((t) => (
        <figure class="card">
          <div class="flex gap-1 text-gold-500">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg>
            ))}
          </div>
          <blockquote class="mt-4 text-sm leading-relaxed text-stone-700">"{t.text}"</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-forest-700 to-forest-900 font-display text-sm font-bold text-gold-300">{t.name[0]}</span>
            <span><span class="block text-sm font-semibold text-forest-950">{t.name}</span><span class="block text-xs text-stone-500">{t.place}</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- FAQ TEASER -->
  <section class="bg-cream-100 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="text-center">
        <p class="section-eyebrow justify-center"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>Good to know</p>
        <h2 class="section-title">Common questions</h2>
      </div>
      <div class="mt-10 space-y-3">
        {FAQS.slice(0, 4).map((f) => (
          <details class="card group !p-0">
            <summary class="cursor-pointer list-none p-6 font-display text-base font-bold text-forest-950 [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">{f.q}
                <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
              </span>
            </summary>
            <p class="px-6 pb-6 text-sm leading-relaxed text-stone-600">{f.a}</p>
          </details>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/contact" class="font-semibold text-forest-800 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-forest-950">See all FAQs and contact us</a>
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="card !p-10 text-center sm:!p-14">
      <p class="section-eyebrow justify-center"><span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>Ready when you are</p>
      <h2 class="section-title">Let us craft something unforgettable</h2>
      <p class="mx-auto mt-4 max-w-xl text-stone-600">Message us your idea on WhatsApp or call {PHONE_DISPLAY}. We reply fast, quote upfront, and craft with love.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={waLink('Hi Eternal Hub! I want to order a customised gift.')} target="_blank" rel="noopener" class="btn-whatsapp w-full sm:w-auto">Chat on WhatsApp</a>
        <a href="/contact" class="btn-outline w-full sm:w-auto">Contact us</a>
      </div>
    </div>
  </section>
</Base>
