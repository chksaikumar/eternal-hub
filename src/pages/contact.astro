---
import Base from '../layouts/Base.astro';
import { PHONE_DISPLAY, WHATSAPP, INSTAGRAM, FAQS } from '../data/site';

const telHref = `tel:${PHONE_DISPLAY.replace(/\s/g, '')}`;
---

<Base
  title="Contact Us | Eternal Hub"
  description="Contact Eternal Hub for premium customized gifts. WhatsApp, phone or Instagram DM. Open all days 10 AM to 8 PM IST."
  path="/contact"
>
  <section class="bg-maroon-950 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="section-eyebrow !text-gold-400"><span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>Get in touch</p>
      <h1 class="font-display text-3xl font-bold text-cream-50 sm:text-5xl">We would love to hear from you</h1>
      <p class="mt-4 max-w-2xl text-cream-200/85">Questions, bulk quotes, or a gift idea at midnight. The fastest way to reach us is WhatsApp.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="grid gap-6 lg:grid-cols-5">
      <div class="space-y-4 lg:col-span-2">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="card flex items-center gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#1faa53] text-white">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.2-.7.3-.9.9-1.1 2.2-.2 3.9a11.6 11.6 0 0 0 4.5 4.2c1.7.8 2.4.9 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3z"/></svg>
          </span>
          <span>
            <span class="block font-display text-lg font-bold text-maroon-950">WhatsApp</span>
            <span class="block text-sm text-stone-600">{PHONE_DISPLAY} (fastest response)</span>
          </span>
        </a>
        <a href={telHref} class="card flex items-center gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-maroon-800 text-gold-300">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
          </span>
          <span>
            <span class="block font-display text-lg font-bold text-maroon-950">Phone</span>
            <span class="block text-sm text-stone-600">{PHONE_DISPLAY}</span>
          </span>
        </a>
        <a href={INSTAGRAM} target="_blank" rel="noopener" class="card flex items-center gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-gold-500 to-maroon-700 text-white">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.9.1s-3.6 0-4.9-.1c-3.3-.1-4.8-1.7-4.9-4.9-.1-1.3-.1-1.6-.1-4.8s0-3.6.1-4.8C2.4 4 4 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-9.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z"/></svg>
          </span>
          <span>
            <span class="block font-display text-lg font-bold text-maroon-950">Instagram</span>
            <span class="block text-sm text-stone-600">@eternalhub.est2026 (10k+ followers)</span>
          </span>
        </a>
        <div class="card">
          <p class="font-display text-lg font-bold text-maroon-950">Business hours</p>
          <p class="mt-1 text-sm text-stone-600">Open all days, 10 AM to 8 PM IST. WhatsApp messages are answered even outside hours.</p>
        </div>
      </div>

      <div class="lg:col-span-3">
        <form id="enquiry-form" class="card !p-6 sm:!p-8">
          <h2 class="font-display text-2xl font-bold text-maroon-950">Send an enquiry</h2>
          <p class="mt-2 text-sm text-stone-600">We usually reply within a few hours on working days.</p>
          <div id="form-fields" class="mt-6 grid gap-4 sm:grid-cols-2">
            <div>
              <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="c-name">Your name</label>
              <input id="c-name" required class="input-field" placeholder="Your name" />
            </div>
            <div>
              <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="c-phone">Phone number</label>
              <input id="c-phone" required class="input-field" placeholder="98XXX XXXXX" />
            </div>
            <div class="sm:col-span-2">
              <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="c-topic">I am interested in</label>
              <select id="c-topic" class="input-field">
                <option>Personalised gift for an occasion</option>
                <option>Return gifts in bulk</option>
                <option>Business branding / logo mount</option>
                <option>Corporate gifting</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label class="mb-1.5 block text-xs font-semibold text-stone-600" for="c-msg">Your message</label>
              <textarea id="c-msg" required rows="4" class="input-field" placeholder="Tell us what you have in mind..."></textarea>
            </div>
          </div>
          <button type="submit" id="form-submit" class="btn-gold mt-6 w-full">Send enquiry</button>
          <div id="form-success" class="mt-6 hidden rounded-2xl bg-green-50 p-6 text-center ring-1 ring-green-200">
            <p class="font-display text-xl font-bold text-green-900">Thank you! Your enquiry is noted.</p>
            <p class="mt-2 text-sm text-green-800">We will get back to you shortly. For an instant reply, message us on WhatsApp at {PHONE_DISPLAY}.</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 py-14 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="section-title text-center">Frequently asked questions</h2>
      <div class="mt-10 space-y-3">
        {FAQS.map((f) => (
          <details class="card group !p-0">
            <summary class="cursor-pointer list-none p-6 font-display text-base font-bold text-maroon-950 [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">{f.q}
                <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
              </span>
            </summary>
            <p class="px-6 pb-6 text-sm leading-relaxed text-stone-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    document.getElementById('form-fields')?.classList.add('hidden');
    document.getElementById('form-submit')?.classList.add('hidden');
    document.getElementById('form-success')?.classList.remove('hidden');
  });
</script>
