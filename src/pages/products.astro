---
import Base from '../layouts/Base.astro';
import ProductArt from '../components/ProductArt.astro';
import ProductCard from '../components/ProductCard.astro';
import { LINES, PRODUCTS, waLink } from '../data/site';

const grouped = LINES.map((l) => ({
  ...l,
  products: PRODUCTS.filter((p) => p.line === l.id),
}));
---

<Base
  title="Products | Eternal Hub, Premium Customized Gifts"
  description="Browse the Eternal Hub collection: acrylic logo mounts from Rs 599, cutout photo frames, LED frames, divine acrylic art, fridge magnets, return gifts and corporate gifting. Factory direct."
  path="/products"
>
  <section class="relative overflow-hidden bg-maroon-950 py-14 sm:py-16">
    <div class="absolute inset-0 opacity-40" style="background: radial-gradient(ellipse 50% 45% at 85% 15%, #c78d3c33, transparent);"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <p class="section-eyebrow !text-gold-400"><span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>The collection</p>
      <h1 class="font-display text-3xl font-bold text-cream-50 sm:text-5xl">Seven crafts, from our factory to you</h1>
      <p class="mt-4 max-w-2xl text-cream-200/85">The real Eternal Hub lineup, as seen on our Instagram. Tap any product to order it on WhatsApp.</p>
    </div>
  </section>

  {grouped.map((g, gi) => (
    <section class={`py-12 sm:py-14 ${gi % 2 === 1 ? 'bg-cream-100' : ''}`} id={g.id}>
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid items-center gap-6 lg:grid-cols-3">
          <div class="lg:col-span-1">
            <div class="overflow-hidden rounded-3xl shadow-xl ring-1 ring-maroon-100">
              <ProductArt art={g.art} class="aspect-[16/10] w-full !rounded-none" />
            </div>
          </div>
          <div class="lg:col-span-2">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <h2 class="font-display text-2xl font-bold text-maroon-950 sm:text-3xl">{g.name}</h2>
                <p class="mt-2 text-sm font-semibold text-gold-700">{g.tagline}</p>
              </div>
              <a
                href={waLink(`Hi Eternal Hub! I want to enquire about your ${g.name}.`)}
                target="_blank"
                rel="noopener"
                class="text-sm font-semibold text-maroon-800 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-maroon-950"
              >
                Enquire about this range
              </a>
            </div>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-stone-600">{g.blurb}</p>
          </div>
        </div>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {g.products.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="card !p-10 text-center">
      <h2 class="font-display text-2xl font-bold text-maroon-950 sm:text-3xl">Need something fully custom?</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm text-stone-600">If you can describe it, we can probably craft it. Send your idea and we will tell you honestly what is possible and what it will cost.</p>
      <a href={waLink('Hi Eternal Hub! I have a custom gift idea to discuss.')} target="_blank" rel="noopener" class="btn-whatsapp mt-6">Discuss your idea</a>
    </div>
  </section>
</Base>
